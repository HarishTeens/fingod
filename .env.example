# Copy to .env and fill in. `make env` generates one with fresh secrets.

# --- Postgres (docker-compose) ---
POSTGRES_USER=fingod
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fingod
POSTGRES_PORT=5432

# --- Go API ---
# Host-side URL (the api container overrides host to `db` via compose).
FINGOD_DB_URL=postgres://fingod:change-me@127.0.0.1:5432/fingod?sslmode=disable
# Bearer token required on every /api/v1 route. Claude Code's /refresh uses this too.
FINGOD_API_TOKEN=change-me
FINGOD_ADDR=127.0.0.1:8080

# --- Ports ---
API_PORT=8080
ADMINER_PORT=8081

# --- MCP ---
# All three MCP servers authenticate interactively via OAuth, so normally this
# stays empty. Only needed as a fallback if Wallet's OAuth flow is unavailable
# for CLI clients — see README.
WALLET_MCP_TOKEN=
